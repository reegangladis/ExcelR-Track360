# ExcelR Track360 - Backend Environment Configuration Template
# Copy this file to .env and provide your local credentials. Do NOT commit .env to Git.

# Application Environment
APP_ENV=development
DEBUG=true
APP_NAME="ExcelR Track360"
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Security (Set a strong 32+ character random secret in production)
SECRET_KEY=dev-secret-key-replace-with-secure-value-in-production

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=track360_user
DATABASE_PASSWORD=track360_password_placeholder
DATABASE_NAME=track360_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_TIMEOUT_SECONDS=3.0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
