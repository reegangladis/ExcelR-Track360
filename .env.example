# ExcelR Track360 - Root Environment Configuration Template
# Copy this file to .env for local Docker Compose orchestration. Do NOT commit .env to Git.

# Docker Compose PostgreSQL Settings
POSTGRES_USER=track360_user
POSTGRES_PASSWORD=track360_secure_pass_replace_in_prod
POSTGRES_DB=track360_dev
POSTGRES_PORT=5432

# Backend API Settings
BACKEND_PORT=8000
APP_ENV=development
SECRET_KEY=dev-secret-key-replace-with-secure-value-in-production

# Frontend Client Settings
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
